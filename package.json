  "version": "2.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:gate": "node --env-file=.env.local tests/forged-session-gate.mjs",
    "test:gate:prod": "node tests/forged-session-gate.mjs",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project=desktop",
