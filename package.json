    "@vercel/blob": "^0.27.3",
    "googleapis": "^173.0.0",
    "lucide-react": "^0.475.0",
    "next": "14.2.35",
    "next-auth": "^4.24.15",
    "nodemailer": "^8.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "playwright": "^1.63.0",
    "vitest": "^2.1.9"
  }
