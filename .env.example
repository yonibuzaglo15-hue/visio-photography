# Site
NEXT_PUBLIC_SITE_URL=https://visio-photography.vercel.app

# ─── Auth.js (Google OAuth) — required for /admin ─────────────
# Local: http://localhost:3000
# Production: https://visio-photography.vercel.app
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
GOOGLE_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-....

# Comma-separated allow-list (case-insensitive). No redeploy needed to add emails on Vercel
# (update env var and redeploy OR use Vercel instant env — still needs redeploy for Next).
ALLOWED_EMAILS=owner@example.com

# LOCAL ONLY — never set on Vercel / production.
# When NODE_ENV!==production AND DEV_AUTH_BYPASS=1, /admin skips Google OAuth
# so Playwright can drive the editor. Asserted impossible in production by tests.
# DEV_AUTH_BYPASS=1

# Blob disk cache (default ON in local/dev). Stores Blob downloads under .data/blob-cache/
# so editor + Playwright don't re-download panoramas. Set BLOB_LOCAL_CACHE=0 to disable.
# Impossible in production. Never set on Vercel.
# BLOB_LOCAL_CACHE=1

# ─── Booking delivery (REQUIRED in production — without these, bookings are rejected with an error) ───
# At least one owner channel must succeed (Calendar, email or WhatsApp) or the API returns 502.
# Google Calendar: service-account JSON (Calendar API enabled). Share the business calendar with the
# service account's client_email ("Make changes to events") and put that calendar's id here.
GOOGLE_CALENDAR_ID=yoni@visioisrael.com
GOOGLE_CALENDAR_CREDENTIALS={"type":"service_account",...}

# Email (owner notification + customer confirmation). Google Workspace / Gmail SMTP with an App Password
# (2-Step Verification must be on for the sending account).
GMAIL_FROM=yoni@visioisrael.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_OWNER=yoni@visioisrael.com

# WhatsApp via Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
OWNER_PHONE=+9725XXXXXXXX

# ─── Asset Processing Pipeline (Production) ──────────────────

# Job store — must be "supabase" on Vercel
PIPELINE_STORE=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# File storage — Vercel Blob (required)
STORAGE_PROVIDER=vercel-blob
BLOB_READ_WRITE_TOKEN=

# Make.com async webhooks (required for video/creative agents)
MAKE_VIDEO_WEBHOOK_URL=
MAKE_CREATIVE_WEBHOOK_URL=
MAKE_WEBHOOK_SECRET=

# Optional
KUULA_API_KEY=

# ─── Removed (do not use) ────────────────────────────────────
# ADMIN_USERNAME / ADMIN_PASSWORD / ADMIN_ALLOWED_EMAIL / ADMIN_SESSION_SECRET
# Fake Google prompt login has been deleted.
